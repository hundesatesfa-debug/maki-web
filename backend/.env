# Server
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:3000

# Database (Local SQLite)
DATABASE_URL="file:./prisma/dev.db"

# JWT
JWT_ACCESS_SECRET=houserent_access_secret_key_2026_production_32chars_min
JWT_REFRESH_SECRET=houserent_refresh_secret_key_2026_production_32chars_min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=houserent-eth-dev
CLOUDINARY_API_KEY=1234567890123456
CLOUDINARY_API_SECRET=houserent_cloudinary_dev_secret_key_placeholder

# Email (Gmail SMTP for password reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@houserentethiopia.com

# Google Maps (optional, for server-side geocoding)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

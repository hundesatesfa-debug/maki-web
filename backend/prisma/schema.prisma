generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// MODELS
// ============================================

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  password            String
  firstName           String    @map("first_name")
  lastName            String    @map("last_name")
  phone               String?
  profilePicture      String?   @map("profile_picture")
  role                String    @default("RENTER") // ADMIN, OWNER, RENTER
  isBanned            Boolean   @default(false) @map("is_banned")
  kycStatus           String    @default("NOT_SUBMITTED") @map("kyc_status") // NOT_SUBMITTED, PENDING, APPROVED, REJECTED
  verifiedBadge       Boolean   @default(false) @map("verified_badge")
  responseTimeHours   Float?    @map("response_time_hours")
  responseRate        Float     @default(0) @map("response_rate")
  refreshToken        String?   @map("refresh_token")
  resetToken          String?   @map("reset_token")
  resetTokenExpiry    DateTime? @map("reset_token_expiry")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  // Relations
  listings                 Listing[]
  favorites                Favorite[]
  messages                 Message[]
  notifications            Notification[]
  conversations            ConversationParticipant[]
  bookingsAsTenant         Booking[] @relation("TenantBookings")
  bookingsAsLandlord       Booking[] @relation("LandlordBookings")
  reviewsAsReviewer        Review[] @relation("ReviewerReviews")
  reviewsAsReviewee        Review[] @relation("RevieweeReviews")
  adminLogs                AdminLog[]
  notificationPreferences  NotificationPreference[]
  payoutAccounts           PayoutAccount[]
  disputesAsFileuer        Dispute[] @relation("DisputeFiler")
  disputesAsResolver       Dispute[] @relation("DisputeResolver")
  transactionsRecords      Transaction[]

  @@map("users")
}

model Listing {
  id                  String        @id @default(uuid())
  ownerId             String        @map("owner_id")
  title               String
  description         String
  price               Float
  address             String
  city                String
  imageUrls           Json          @default("[]")
  latitude            Float
  longitude           Float
  bedrooms            Int
  bathrooms           Int
  houseType           String        @map("house_type") // APARTMENT, VILLA, CONDO, STUDIO, HOUSE
  status              String        @default("AVAILABLE") // AVAILABLE, RENTED, UNAVAILABLE
  isPremium           Boolean       @default(false) @map("is_premium")
  amenities           String?       @default("[]") // JSON array stored as text
  availableFrom       DateTime?     @map("available_from")
  availableTo         DateTime?     @map("available_to")
  minStay             Int           @default(1) @map("min_stay")
  averageRating       Float         @default(0) @map("average_rating")
  cancellationPolicy  String        @default("MODERATE") @map("cancellation_policy") // STRICT, MODERATE, FLEXIBLE, NON_REFUNDABLE
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relations
  owner               User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  images              ListingImage[]
  favorites           Favorite[]
  conversations       Conversation[]
  premiumListing      PremiumListing?
  bookings            Booking[]
  reviews             Review[]
  invoices            Invoice[]

  // Indexes
  @@index([city])
  @@index([price])
  @@index([houseType])
  @@index([status])
  @@index([isPremium, createdAt])
  @@index([ownerId])
  @@index([createdAt])
  @@map("listings")
}

model ListingImage {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  url       String
  publicId  String   @map("public_id")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_images")
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
  @@map("favorites")
}

model Conversation {
  id        String   @id @default(uuid())
  listingId String?  @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  listing      Listing?                  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  joinedAt       DateTime @default(now()) @map("joined_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  senderId       String   @map("sender_id")
  content        String
  isRead         Boolean  @default(false) @map("is_read")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      String   // NEW_MESSAGE, LISTING_UPDATE, PREMIUM_EXPIRY
  title     String
  content   String?
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model PremiumListing {
  id         String        @id @default(uuid())
  listingId  String        @unique @map("listing_id")
  startDate  DateTime      @map("start_date")
  endDate    DateTime      @map("end_date")
  amountPaid Float         @map("amount_paid")
  status     String        @default("ACTIVE") // ACTIVE, EXPIRED, CANCELLED
  createdAt  DateTime      @default(now()) @map("created_at")

  // Relations
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([status, endDate])
  @@map("premium_listings")
}

// ============================================
// PHASE 2 MODELS
// ============================================

model Booking {
  id              String    @id @default(uuid())
  propertyId      String    @map("property_id")
  tenantId        String    @map("tenant_id")
  landlordId      String    @map("landlord_id")
  moveInDate      DateTime  @map("move_in_date")
  durationMonths  Int       @map("duration_months")
  status          String    @default("REQUESTED") @map("status") // REQUESTED, CONFIRMED, COUNTER_OFFERED, PAID, ACTIVE, COMPLETED, CANCELLED, DECLINED
  monthlyRent     Float     @map("monthly_rent")
  depositAmount   Float     @map("deposit_amount")
  message         String?
  responseTimeHours Float?  @map("response_time_hours")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  property        Listing       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  tenant          User          @relation("TenantBookings", fields: [tenantId], references: [id], onDelete: Restrict)
  landlord        User          @relation("LandlordBookings", fields: [landlordId], references: [id], onDelete: Restrict)
  payments        Payment[]
  reviews         Review[]
  contracts       Contract[]
  disputes        Dispute[]
  subscriptions   SubscriptionPlan[]

  @@index([tenantId])
  @@index([landlordId])
  @@index([propertyId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id                String    @id @default(uuid())
  bookingId         String    @map("booking_id")
  amount            Float
  currency          String    @default("ETB") // ETB, USD
  paymentGateway    String    @map("payment_gateway") // TELEBIRR, PAYPAL, STRIPE, BANK_TRANSFER, CHAPA
  paymentReference  String?   @map("payment_reference")
  status            String    @default("PENDING") @map("status") // PENDING, PROCESSING, COMPLETED, FAILED, REFUNDED, CANCELLED
  paymentType       String    @default("DEPOSIT") @map("payment_type") // DEPOSIT, MONTHLY_RENT, FULL_PAYMENT
  metadata          String?   // JSON object stored as text
  idempotencyKey    String?   @unique @map("idempotency_key")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  invoices          Invoice[]

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}

model Transaction {
  id              String    @id @default(uuid())
  paymentId       String    @map("payment_id")
  userId          String    @map("user_id")
  amount          Float
  type            String    // CHARGE, REFUND, COMMISSION_DEDUCTION
  status          String    @default("PENDING") // PENDING, COMPLETED, FAILED
  idempotencyKey  String?   @unique @map("idempotency_key")
  gatewayResponse String?   @map("gateway_response") // JSON response from gateway
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("transactions")
}

model Review {
  id                String    @id @default(uuid())
  bookingId         String    @map("booking_id")
  reviewerId        String    @map("reviewer_id")
  revieweeId        String    @map("reviewee_id")
  reviewType        String    @map("review_type") // PROPERTY, LANDLORD, TENANT
  rating            Int       // 1-5 stars
  text              String?
  isVerified        Boolean   @default(true) @map("is_verified") // Verified if booking was completed
  status            String    @default("PUBLISHED") // PUBLISHED, PENDING_MODERATION, REJECTED
  moderationNotes   String?   @map("moderation_notes")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer          User      @relation("ReviewerReviews", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewee          User      @relation("RevieweeReviews", fields: [revieweeId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@map("reviews")
}

model Contract {
  id              String    @id @default(uuid())
  bookingId       String    @map("booking_id")
  documentUrl     String?   @map("document_url")
  signedBy        String?   @map("signed_by") // Comma-separated user IDs who have signed
  signedAt        DateTime? @map("signed_at")
  status          String    @default("PENDING") // PENDING, SIGNED, EXPIRED
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("contracts")
}

model Notification {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  type            String    // BOOKING_REQUEST, BOOKING_ACCEPTED, PAYMENT_RECEIVED, REVIEW_RECEIVED, etc.
  title           String
  message         String?
  relatedId       String?   @map("related_id") // ID of related entity (booking, payment, review, etc.)
  relatedType     String?   @map("related_type") // Type of related entity (BOOKING, PAYMENT, REVIEW, etc.)
  channels        String    @default("IN_APP") // JSON array: IN_APP, EMAIL, SMS, PUSH
  isRead          Boolean   @default(false) @map("is_read")
  status          String    @default("PENDING") // PENDING, SENT, DELIVERED, FAILED
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model NotificationPreference {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  channel         String    // IN_APP, EMAIL, SMS, PUSH
  enabled         Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, channel])
  @@map("notification_preferences")
}

model AdminLog {
  id              String    @id @default(uuid())
  adminId         String    @map("admin_id")
  action          String    // APPROVE_LISTING, REJECT_LISTING, VERIFY_USER, SUSPEND_USER, etc.
  targetId        String    @map("target_id")
  targetType      String    @map("target_type") // LISTING, USER, BOOKING, REVIEW, etc.
  changes         String?   // JSON describing what changed
  reason          String?
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  admin           User      @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId])
  @@map("admin_logs")
}

model Dispute {
  id              String    @id @default(uuid())
  bookingId       String    @map("booking_id")
  filedBy         String    @map("filed_by") // User ID who filed the dispute
  reason          String
  description     String?
  evidenceUrls    String?   @map("evidence_urls") // JSON array of URLs
  status          String    @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED, CLOSED
  adminDecision   String?   @map("admin_decision")
  refundAmount    Float?    @map("refund_amount")
  resolvedBy      String?   @map("resolved_by") // Admin user ID
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  filer           User      @relation("DisputeFiler", fields: [filedBy], references: [id], onDelete: Restrict)
  resolver        User?     @relation("DisputeResolver", fields: [resolvedBy], references: [id], onDelete: Set Null)

  @@index([bookingId])
  @@index([status])
  @@map("disputes")
}

model PayoutAccount {
  id                      String    @id @default(uuid())
  landlordId              String    @map("landlord_id")
  bankName                String    @map("bank_name")
  accountNumber           String    @map("account_number")
  accountHolderName       String    @map("account_holder_name")
  verified                Boolean   @default(false)
  verificationDocumentUrl String?   @map("verification_document_url")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relations
  landlord                User      @relation(fields: [landlordId], references: [id], onDelete: Cascade)

  @@map("payout_accounts")
}

model SubscriptionPlan {
  id                      String    @id @default(uuid())
  bookingId               String    @map("booking_id")
  gatewaySubscriptionId   String?   @map("gateway_subscription_id")
  paymentGateway          String    @map("payment_gateway")
  status                  String    @default("PENDING") // PENDING, ACTIVE, PAUSED, CANCELLED
  amount                  Float
  currency                String    @default("ETB")
  nextChargeDate          DateTime? @map("next_charge_date")
  cycleCount              Int       @default(0) @map("cycle_count")
  failedAttempts          Int       @default(0) @map("failed_attempts")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  // Relations
  booking                 Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("subscription_plans")
}

model Invoice {
  id              String    @id @default(uuid())
  paymentId       String    @map("payment_id")
  invoiceNumber   String    @unique @map("invoice_number")
  tenantId        String    @map("tenant_id")
  landlordId      String    @map("landlord_id")
  propertyId      String    @map("property_id")
  amount          Float
  currency        String    @default("ETB")
  pdfUrl          String?   @map("pdf_url")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  payment         Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  tenant          User      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  landlord        User      @relation(fields: [landlordId], references: [id], onDelete: Restrict)
  property        Listing   @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@map("invoices")
}

model TransactionAuditLog {
  id              String    @id @default(uuid())
  userId          String?   @map("user_id")
  bookingId       String?   @map("booking_id")
  gatewayName     String?   @map("gateway_name")
  amount          Float?
  currency        String?
  status          String?
  action          String?   // PAYMENT_INITIATED, WEBHOOK_RECEIVED, PAYMENT_COMPLETED, REFUND_PROCESSED, etc.
  errorMessage    String?   @map("error_message")
  metadata        String?   // JSON
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("transaction_audit_logs")
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
  RENTER
}

enum HouseType {
  APARTMENT
  VILLA
  CONDOMINIUM
  STUDIO
  TOWNHOUSE
}

enum HouseStatus {
  AVAILABLE
  RENTED
  UNAVAILABLE
}

model User {
  id              String         @id @default(uuid())
  name            String
  email           String         @unique
  password        String
  phoneNumber     String?
  profilePicture  String?
  role            Role           @default(RENTER)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  houses          House[]        @relation("HouseOwner")
  favorites       Favorite[]
  messages        Message[]
  notifications   Notification[]
  
  renterConversations Conversation[] @relation("ConversationRenter")
  ownerConversations  Conversation[] @relation("ConversationOwner")

  @@index([email])
}

model House {
  id              String         @id @default(uuid())
  title           String
  description     String         @db.Text
  price           Float
  address         String
  city            String
  latitude        Float
  longitude       Float
  bedrooms        Int
  bathrooms       Int
  houseType       HouseType
  status          HouseStatus    @default(AVAILABLE)
  
  isPremium       Boolean        @default(false)
  premiumEndsAt   DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  ownerId         String
  owner           User           @relation("HouseOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  
  images          Image[]
  favorites       Favorite[]

  @@index([city])
  @@index([price])
  @@index([houseType])
  @@index([isPremium, premiumEndsAt])
}

model Image {
  id        String   @id @default(uuid())
  url       String
  houseId   String
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([houseId])
}

model Favorite {
  id        String   @id @default(uuid())
  userId    String
  houseId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  house     House    @relation(fields: [houseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, houseId])
}

model Conversation {
  id          String    @id @default(uuid())
  renterId    String
  ownerId     String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  renter      User      @relation("ConversationRenter", fields: [renterId], references: [id], onDelete: Cascade)
  owner       User      @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([renterId, ownerId])
}

model Message {
  id             String       @id @default(uuid())
  content        String       @db.Text
  conversationId String
  senderId       String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   // e.g., 'MESSAGE', 'LISTING', 'PREMIUM'
  link      String?  // Optional URL to redirect the user
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
